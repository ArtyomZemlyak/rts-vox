[
 (name:"Фугасный взрыв", description:"Заряд в выбранной точке: ударная волна, разрушение, обломки и нагрев. После размещения нажмите F.", icon:"bomb", effect:0, power_milli:1000, detonate:true),
 (name:"Осадный взрыв", description:"Тяжёлый взрыв для проверки толстых стен и крупных сборок. Мощность настраивается у источника.", icon:"bomb", effect:9, power_milli:1000, detonate:true),
 (name:"Энергетический взрыв", description:"Энергетический заряд без полёта снаряда: общий расчёт волны и разрушения материалов.", icon:"zap", effect:2, power_milli:1000, detonate:true),
 (name:"Ядерный взрыв", description:"Штатный ядерный заряд в выбранной точке. Грунт, здания, лес и корпуса используют общую физику.", icon:"radiation", effect:8, power_milli:1000, detonate:true),
 (name:"Подрыв опоры", description:"Локальный заряд уменьшенной мощности. Поставьте на опору: отделение и падение конструкции рассчитывает движок.", icon:"hammer", effect:0, power_milli:500, detonate:true),
 (name:"Аннигиляция", description:"Аннигиляционный заряд в точке: проверка расхода материи и реакции сборки.", icon:"zap", effect:6, power_milli:1000, detonate:true),
 (name:"Огонь и поджог", description:"Поставьте источник огня, затем выберите цель. F запускает штатный огнемёт: горение, топливо, тепло и дым.", icon:"flame", effect:4, power_milli:1000, detonate:false),
 (name:"Лазерный нагрев", description:"Поставьте источник, затем выберите цель. Лазер нагревает и плавит материал по общим правилам.", icon:"sparkles", effect:3, power_milli:1000, detonate:false),
 (name:"Бронебойный удар", description:"Поставьте источник и задайте цель. Настоящий снаряд проверяет пробитие, рикошет и повреждение узлов.", icon:"crosshair", effect:1, power_milli:1000, detonate:false),
]
