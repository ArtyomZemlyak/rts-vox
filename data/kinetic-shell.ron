// A solid tank round. Work is spent only on the impact ray, not a blast wave.
// Crossing a sloped or thick plate consumes more cells; fragments are real
// removed matter. World unit = 100 mm, simulation = 30 ticks/second.
(
    delivery: Kinetic,
    motion: Ballistic,
    charge_ticks: 12,
    half_cells: 20,
    cell_units: 2,
    energy: 12000,
    material_energy_j: 1800000,
    air_cost: 100,
    soil_resistance: 1200,
    concrete_resistance: 1600,
    steel_resistance: 6500,
    unit_ablation_resistance: 180,
    unit_role_resistance_milli: (1000, 1800, 650, 1100, 350),
    wave_work_per_tick: 4096,
    capture_cells_per_tick: 40000,
    edits_per_tick: 8192,
    fragment_box: 1,
    hull_impulse_milli: 0,
    fire_tick: 45,
    shell_speed: 280,
    gravity: 98,
    heat_units: 0,
    heat_per_cell: 0,
    gas_cell_units: 5,
    gas_display_mm: 640,
    gas_source_radius: 1,
    gas_temperature_k: 300,
    gas_fuel_milli: 0,
    gas_pressure_milli: 0,
    reaction_milli: 0,
    cooling_milli: 1250,
    buoyancy_milli: 1000,
)
