// Energy shields on the range (ADR-276). Charge is counted in the wave
// units the weapons declare as `energy`: explosion.ron 2300, energy-cannon.ron
// 2700. A dome holds one round of either and falls to the second inside the
// recharge window: 2300 + 2700 is more than the capacity.
(
    capacity: 4000,
    // A spent dome fills in twenty seconds.
    // Authored 30 Hz charge quantum, integrated without fractional loss.
    recharge_per_tick: 7,
    // Three seconds down after a collapse.
    overload_ticks: 60,
    default_radius: 40,
)
