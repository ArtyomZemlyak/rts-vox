// Giant assault spider: 17.6 x 16 metres, eight articulated legs.
(
    speed: 24, step: 14, charge_ticks: 24,
    chassis: (
        mass: 400, density: 2400, thrust: 1200, brake: 1800,
        turn: 28, pivot: 45, pivot_speed: 0, climb: 90, descend: 105,
        stiffness: 26, damping: 7, travel_cm: 70, clearance_cm: 380,
        inertia: 225, ang_damp: 3, support_x_cm: 500, support_z_cm: 600,
        max_tilt_pct: 84, contact_cm: 100, approach_pct: 50,
        settle_pct: 50, settle_tilt_pct: 50, settle_catch_pct: 30,
        push_max_mps: 4, spin_max_deg_s: 45,
        gait: Some((stride_cm: 440, duty_pct: 75, lift_cm: 100,
            offset_pct: (0, 50, 25, 75))),
    ),
    // 0.6 second opening pass, starting up to 12 m before the target.
    laser_sweep: Some((ticks: 18, lead_units: 120)),
    // 90-degree transfer takes at least five seconds; the beam stays live.
    laser_tracking: Some((
        yaw: (speed_deg_s: 18, accel_deg_s2: 36, aim_millidegrees: 1500),
        elevation: (speed_deg_s: 90, accel_deg_s2: 360, aim_millidegrees: 1500),
        fire_millidegrees: 60000, elevation_limit_degrees: 75,
    )),
    laser: (burst_ticks: 240, interval_ticks: 1, range: 2800,
        standoff_milli: 800, spread_milli: 0, work: 600,
        // Siege beam: thick armour must melt even while the contact moves.
        // Heat is energy per hit; cell volume and conduction still apply.
        heat: 16000, heat_radius: 4, fracture_j: 1, reload_ticks: 75),
)
