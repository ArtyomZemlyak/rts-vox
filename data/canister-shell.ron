// One explosive submunition in a six-round T2 howitzer salvo; all values per round.
// The GPU gas is presentation; it cannot issue damage or terrain edits.
(
    delivery: Blast,
    motion: Ballistic,
    charge_ticks: 8,
    half_cells: 18,
    cell_units: 3,
    energy: 20000,
    // The authored 40% body share retains the former 180 MJ hull budget;
    // the remaining 270 MJ pays terrain fracture for this submunition.
    material_energy_j: 450000000,
    air_cost: 100,
    soil_resistance: 165,
    // Soil confinement per world unit below the impact; hull work is unchanged.
    soil_depth_cost: 400,
    soil_fracture_milli: 4000,
    concrete_resistance: 380,
    // Intact armor still stops the stock shell; repeated hits and a 4x
    // charge can tear the exposed face instead of leaving it immaculate.
    steel_resistance: 6000,
    unit_role_resistance_milli: (1000, 1800, 650, 1100, 350),
    wave_work_per_tick: 65536,
    capture_cells_per_tick: 147456,
    edits_per_tick: 65536,
    // Connected large fragments mixed with smaller chips (ADR-475).
    fragment_box: 4,
    // Push on a hull: thousandths of a newton-second per unit of wave
    // pressure the body absorbed (ADR-297) - what dents the side throws
    // the machine, and a hull the wave never reached is not pushed.
    hull_impulse_milli: 2,
    fire_tick: 30,
    shell_speed: 350,
    // The fireball lights fuel within thirty-two units: eighty heat at the
    // centre, falling to nothing at the edge, so the crowns of the trees
    // beside the one it destroys catch (ADR-277).
    heat_units: 24,
    heat_per_cell: 80,
    gravity: 98,
    gas_cell_units: 5,
    // Visible cubes are larger than the transport grid; the physics is unchanged.
    gas_display_mm: 640,
    gas_source_radius: 32,
    gas_temperature_k: 2900,
    gas_fuel_milli: 1800,
    gas_pressure_milli: 2200,
    reaction_milli: 1800,
    cooling_milli: 650,
    buoyancy_milli: 1600,
)
