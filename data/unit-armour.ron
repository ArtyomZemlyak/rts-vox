// Mechanical grades share steel's density, reclamation and appearance.
// Ablation and fracture toughness are different properties; no scalar HP.
// Role order: armour, core, engine, weapon, sensor. 1000 = stock T1 steel.
(
    grades: [
        (name: "T1 steel", ablation_milli: (1000,1000,1000,1000,1000),
            fracture_milli: (1000,1000,1000,1000,1000)),
        (name: "T2 reinforced steel", ablation_milli: (1500,1500,1500,1500,1250),
            fracture_milli: (3000,3000,3000,3000,2000)),
        (name: "T3 composite steel", ablation_milli: (2000,1500,1500,2000,1500),
            fracture_milli: (8000,8000,8000,48000,4000)),
    ],
    units: [
        (Tank, 0), (Strider, 1), (Spider, 2), (Artillery, 0),
        (TurretT1, 0), (TurretT2, 1), (Base, 0), (ArtilleryT2, 1),
        (ArtilleryTurretT2, 1), (ArtilleryTurretT3, 2), (NuclearSilo, 2),
        (Crawler, 0),
    ],
)
