// Числа тика. **Единственное место, где они живут** (ADR-140):
// `CLAUDE.md` требует, чтобы игровое число — стоимость, урон, скорость,
// тайминг — лежало в данных, а не в исходнике.
//
// Это не контент пака: тут не то, что мод добавляет, а правила,
// по которым идёт тик. Меняя их, меняешь игру для всех участников
// lockstep разом.
//
// Пропущенное поле — ошибка разбора, а не ноль: умолчание означало бы,
// что число всё-таки живёт в коде.
(
    blast: (
        cell: 2, samples_per_tick: 65536, wave_pops_per_tick: 16384,
        edits_per_tick: 16384, max_pending: 16, max_claims: 4096, max_fragments: 32768, max_flying: 4096, max_resting_fragments: 131072, pile_cell: 8, fragment_box: 4,
        resistance_per_strength: 2, fracture_kj_m3_per_strength: 100,
        density_kg_m3_per_density: 10, motion_pct: 15, body_energy_pct: 40, body_resistance_ppm: 5000, lift_pct: 45,
        scatter_pct: 65, speed_min_pct: 25, small_piece_pct: 25,
        max_speed_mm_s: 30000, drag_pct: 99, bounce_pct: 20,
        friction_pct: 60, sleep_mm_s: 400, rest_check_ticks: 8, push_pct: 150, push_up_pct: 25,
        // Кувырок летящего куска: градусов в секунду на единицу скорости
        // за тик (ADR-309). Кусок, летящий на две единицы за тик, делает
        // оборот примерно за полторы секунды.
        spin_deg_s: 120,
        // Удар корпусов (ADR-455): доля энергии, теряемой при ударе,
        // которая ломает металл там, где корпуса коснулись, и скорость
        // сближения, ниже которой удар не ломает ничего. Два
        // шестидесятитонных танка, сошедшиеся лоб в лоб на полном ходу,
        // сближаются на восьми метрах в секунду и теряют 960 кДж;
        // половина их отламывает по четыре клетки брони с каждого.
        contact_deform_pct: 50, contact_min_mm_s: 1500,
    ),
    // --- бой и падение
    //
    // Урона за воксель высоты падения (ADR-036) сверх бесплатного
    // уступа `max_step` — это правило, а число уступа живёт ниже
    // (ADR-139, ADR-227). Воксель — десять сантиметров: падение с трёх
    // метров стоит 25 вокселей тела, с тридцати — смертельно при
    // трёхстах. На ребре 0.5 м стояла тройка, то есть шесть за метр;
    // ровно впятеро мельче не делится, и метр падения подорожал
    // в 1.67 раза.
    fall_damage_per_voxel: 1,

    // Ускорение свободного падения, вокселей в секунду за секунду.
    // Мировой воксель — десять сантиметров (ADR-227), значит 98
    // вокселей в секунду за секунду — это 9.8 м/с², земное тяготение.
    //
    // Одно число на всех: юнита, обломок и снаряд (ADR-173, ADR-658).
    // Пресеты оружия и `range-fire.ron` повторяют его, и тест модов
    // требует совпадения. Разные значения означали бы, что юнит и кусок,
    // отвалившиеся вместе, разъезжаются в воздухе.
    gravity: 98,

    // Через сколько тиков юнит перевыбирает цель (ADR-116). Тридцать —
    // это секунда при 30 Гц. Цель, живая и в радиусе, остаётся целью.
    retarget_period: 30,
    // Потолок поисков цели за тик (ADR-114). Упёршийся поиск
    // откладывается на следующий тик, а не останавливает очередь.
    max_target_searches: 512,

    // Числа самого оружия — скорость, урон, перезарядка, воронка —
    // лежат в data/weapons.ron: они у каждого вида свои (ADR-169).
    // Здесь только общие потолки.
    max_shots: 8192,
    // Радиус попадания, вокселей: два метра — полуширина танка
    // с запасом. На ребре 0.5 м стоял один воксель, минимум,
    // а не выбор (ADR-227).
    shot_hit_radius: 20,

    // --- приказы (ADR-195)
    //
    // Потолок приказов, применяемых за тик. Упёршийся откладывается
    // на следующий тик, а не теряется. Число выбрано так, чтобы
    // в игре **не срабатывать**: щелчок по выделенной армии в пять
    // тысяч юнитов — это пять тысяч приказов, то есть два тика,
    // и это худший случай, а не обычный. Потолок, упирающийся каждый
    // тик, — не предохранитель, а постоянное ухудшение (ADR-114).
    max_orders_per_tick: 4096,
    // Насколько близко к точке приказа юнит считает, что дошёл,
    // в мировых единицах. Больше расталкивания (12): толпа, идущая
    // в одну точку, физически не может встать ближе, чем расходятся
    // её соседи, и меньший радиус означал бы, что дошедших нет.
    order_arrive: 80,
    engagement_pct: (85, 95),
    // Радиус шара породы, снимаемого копателем за тик, в вокселях:
    // метр. Тот же, что у копателей эталонного сценария.
    dig_radius: 10,

    // --- экономика (ADR-230)
    //
    // Потолок запаса стороны без единого склада. Хватает на завод
    // плюс сдачу: партия начинается с того, что краулер копает
    // и строит завод, а не с того, что складывать некуда.
    base_store: 2400000,
    // Насколько близко к складу, недострою или обломку надо подъехать,
    // чтобы работать. Больше радиуса прихода (80): постройка крупная,
    // и утыкаться в её середину незачем.
    work_reach: 160,
    // Выход переработки на складе — семь десятых. **Единственный сток,
    // доступный с первого дня** (docs/07-economy.md): без него материя
    // только перетекает, и партия не может кончиться экономически.
    refine_num: 7,
    refine_den: 10,
    // Доля содержимого, теряемая при разрушении контейнера (ADR-021):
    // четверть. Остальное ложится обломком и реклеймится.
    breach_loss_num: 1,
    breach_loss_den: 4,
    // Поисков склада и обломка за тик, одним бюджетом на оба.
    // Шестьдесят четыре — это больше, чем краулеров в партии,
    // то есть потолок в игре не срабатывает: потолок, упирающийся
    // каждый тик, — не предохранитель, а постоянное ухудшение
    // (ADR-114).
    max_dock_searches: 64,
    // Заказов в очереди одного завода.
    max_build_queue: 8,

    // --- поле направлений (ADR-138)
    //
    // Поле целиком на карте D-7 считается 40 мс — вчетверо больше
    // всего тика, — поэтому работа идёт порциями. Потолки фиксированы:
    // разное отставание у разных клиентов это десинк (ADR-089).
    //
    // Клеток на сборку графа за тик. Узел сборки стоит четырёх запросов
    // перехода, и это самая дорогая порция на узел.
    flow_cells_per_tick: 2000,
    // Узлов на разметку компонент, выбор целей и публикацию.
    flow_scan_per_tick: 8000,
    // Секторов за тик: пересборка графа секторов и решение поля идут
    // посекторно (ADR-152). Сектор — шестнадцать нав-клеток по стороне.
    flow_sectors_per_tick: 4,

    // --- навигация
    //
    // Рост юнита в вокселях: столько нужно свободного над полом,
    // чтобы уровень считался проходимым.
    unit_height: 20,
    // Сторона нав-клетки в вокселях (ADR-014). Грубее сетки мира
    // нарочно: один обломок не перекрывает клетку, завал из сотни —
    // перекрывает, и это уже механика.
    nav_cell: 10,
    // Какой перепад юнит перешагивает (ADR-121). Больше — обрыв,
    // ребра нет. Пять вокселей — полметра, тот же уступ, что и на ребре
    // 0.5 м (ADR-227): воронка глубже полуметра становится ловушкой —
    // упасть в неё юнит умеет, выбраться нет. Тот же уступ — бесплатный
    // шаг вниз: спуск не выше него падением не считается и урона
    // не даёт (ADR-139, ADR-227).
    max_step: 5,

    // --- бой и толчея
    //
    // Радиус расталкивания в мировых единицах: ближе этого юниты
    // расходятся. Это единственное место фазы движения, где стоимость
    // нелинейна — она линейна по числу пар в радиусе.
    // По телу юнита, а не на глаз: танк 60x30x30 вокселей тела
    // по 0.1 м — это шесть метров в длину, и мировой воксель теперь
    // того же ребра (ADR-227), то есть шестьдесят вокселей.
    // Расталкивание в три клетки ставило шестиметровые машины
    // в полутора метрах друг от друга, и строй шёл сквозь себя (ADR-172).
    separation: 60,
    // Дальность стрельбы. «Внутри радиуса ли» решается сравнением
    // квадратов: корень в симуляции — последнее средство (ADR-071).
    range: 120,

    // --- ход машины (ADR-220, ADR-234)
    //
    // Скорость и курс — состояние юнита, а не мгновенный вектор:
    // машина разгоняется, тормозит и доворачивает с пределами.
    // Пределы у видов ходовой разные, и живут они здесь.
    //
    // **Разгон выводится из тяги и массы**, а не задаётся числом:
    // `thrust`/`brake` — килоньютоны, `mass` — тонны номинальной
    // машины вида, и тяга на массу даёт метры в секунду за секунду.
    // Масса юнита — объём его тела на `density` (кг/м³); юнит без
    // тела получает номинал. Крупная машина того же вида разгоняется
    // и доворачивает медленнее — тяга растёт с массой как её степень
    // две трети (площадь опоры против объёма), а не пропорционально.
    // Шестьдесят тонн при ста восьмидесяти килоньютонах — три метра
    // в секунду за секунду: с нуля до трёх метров в секунду за
    // секунду с небольшим. Торможение сильнее тяги: машина
    // останавливается быстрее, чем трогается, но не мгновенно —
    // три метра в секунду гасятся за три четверти секунды.
    //
    // `turn` — предел угловой скорости, градусов в секунду. Разгон
    // к нему — из тяги на плече `support_z_cm` и момента инерции
    // `inertia`: у гусеничной около полусекунды до полного доворота.
    //
    // `pivot` — за каким углом до цели машина входит в разворот.
    // Больше прямого угла **нарочно**: поле направлений четырёхстороннее,
    // на диагонали курс отстаёт от него на полпрямого постоянно, и порог
    // ровно в девяносто превратил бы диагональ в череду остановок.
    // `pivot_speed` — с какой долей хода машина разворачивается:
    // гусеничная идёт дугой, шагающая встаёт и крутится на месте.
    //
    // `climb`/`descend` — доля предельной скорости в процентах на
    // подъёме и на спуске. Перепад больше `max_step` ребра не имеет
    // вовсе: слишком круто — не едет, и это правило навигации,
    // а не число хода.
    tracked: (
        // Ванильный танк: 25.2 м³ тела при 2 400 кг/м³ — шестьдесят
        // тонн. Плотность средняя по машине, не по стали: корпус
        // полый, и сплошная сталь дала бы двести тонн.
        mass: 60,
        density: 2400,
        thrust: 180,
        brake: 240,
        turn: 90,
        pivot: 105,
        pivot_speed: 40,
        climb: 60,
        descend: 125,
        // Подвеска гусеничной. **Мягкая, и это замер, а не вкус**:
        // наклон при торможении равен `h·a / (k·Σr²)`, и при жёсткости
        // 44 остановка в 1.2 g наклоняла корпус на десятую долю
        // градуса — физика была честной и невидимой. При двойке —
        // несколько градусов, и танк клюёт носом так, что это видно
        // с игровой камеры. Демпфирование единица: подвеска
        // передемпфирована, торсионный танк не раскачивается, он
        // клюёт и встаёт (ADR-225). Вес держит натяг пружины, а не
        // жёсткость (ADR-234): корпус в покое стоит ровно на клиренсе.
        // Опора по углам ленты: два с половиной метра к носу, метр
        // двадцать к борту.
        stiffness: 2,
        damping: 1,
        travel_cm: 22,
        clearance_cm: 45,
        inertia: 125,
        ang_damp: 4,
        support_x_cm: 250,
        support_z_cm: 120,
        max_tilt_pct: 91,
        // Лента лежит на метр двадцать в обе стороны от опоры: ров
        // короче этого перекрывается, уступ берётся за разбег с
        // подъёмом шесть десятых на единицу пути (ADR-272).
        contact_cm: 120,
        approach_pct: 60,
        // Корпус догоняет ушедший вверх пол не быстрее трети хода
        // за тик: подъём на уступ идёт ровно, а не рывками, и половина
        // поправки идёт в наклон над просевшей стороной (ADR-295):
        // на уступе нос задирается прежде, чем корпус поднимается.
        settle_pct: 35,
        settle_tilt_pct: 50,
        settle_catch_pct: 30,
        // Предел толчка взрыва: скорость и вращение корпуса (ADR-304).
        push_max_mps: 8,
        spin_max_deg_s: 120,
        gait: None,
    ),
    // Шагающая: легче и слабее гусеничной, зато крутится на месте
    // и лезет в гору. Это и есть разница видов — иначе их два только
    // на словах.
    walking: (
        // Ванильный шагоход: около пяти кубометров тела — двенадцать
        // тонн при той же плотности.
        mass: 12,
        density: 2400,
        thrust: 48,
        brake: 60,
        turn: 60,
        pivot: 130,
        pivot_speed: 0,
        climb: 90,
        descend: 105,
        // Подвеска шагающей: жёстче и выше, опора уже — машина стоит
        // на ногах, а не на лентах, и стабилизируется активно.
        stiffness: 26,
        damping: 7,
        travel_cm: 40,
        clearance_cm: 150,
        inertia: 225,
        ang_damp: 3,
        support_x_cm: 90,
        support_z_cm: 90,
        max_tilt_pct: 84,
        // Стопа ставится на площадку в шаг длиной; уступ нога берёт
        // за половину шага, а не мгновенно.
        contact_cm: 60,
        approach_pct: 50,
        settle_pct: 50,
        settle_tilt_pct: 50,
        settle_catch_pct: 30,
        // Предел толчка взрыва: скорость и вращение корпуса (ADR-304).
        push_max_mps: 8,
        spin_max_deg_s: 120,
        // Походка: боковая последовательность — корма, нос той же
        // стороны, корма другой, нос другой, по четверти цикла. Три
        // ноги на земле всегда, одна в переносе; за цикл корпус
        // проходит метр шестьдесят, ступня отрывается на сорок
        // сантиметров.
        gait: Some((
            stride_cm: 160,
            duty_pct: 75,
            lift_cm: 40,
            offset_pct: (25, 75, 0, 50),
        )),
    ),

    // --- тела и правки мира
    //
    // Потолок правок мира за тик — `MAX_VOXEL_EDITS_PER_TICK` канона
    // (ADR-013, ADR-045). Считает затронутые воксели, в любом масштабе,
    // и столько же записей очереди разрешает просмотреть за тик.
    // Упёршаяся правка откладывается на следующий тик, а не теряется.
    // Число выбрано так, чтобы на эталонном сценарии **не срабатывать**
    // (ADR-114, ADR-116): двадцать четыре копателя и воронки боя ставят
    // в очередь порядка десяти тысяч правок за тик, и хвоста в очереди
    // после тика не остаётся. До ADR-227 жило литералом в исходнике.
    max_voxel_edits_per_tick: 65536,
    // Чанков, построенных из генератора за тик (ADR-114). Второй
    // потолок дренажа очереди: забой, вошедший в шестнадцать
    // нетронутых чанков разом, без него стоит тридцать четыре
    // миллисекунды.
    max_materialize_per_tick: 4,
    // Потолок на размер одного отвала в вокселях (ADR-119). Больше —
    // не тело, а кусок породы, повисший в воздухе: он не падает
    // и телом не становится. Замер на десяти тысячах тиков: при
    // 4096 отказов 2 533, при 65 536 — ноль, и фаза тел дороже
    // на 1.2%, то есть в пределах разброса (ADR-193).
    max_body_cells: 8192000,
    // Жёсткий потолок живых динамических тел (ADR-015). Упёршийся
    // отвал схлопывается на месте, а не встаёт в очередь.
    max_bodies: 256,
    impact: (
        // Work to deform/fracture material; these are gameplay material models.
        // Armour, core, engine, weapon, sensor: kJ per cubic metre.
        detach_work_per_tick: 8192, detach_jobs_per_tick: 32,
        work_kj_m3: (160000, 20000, 60000, 180000, 8000), motion_pct: 10,
        cells_per_tick: 16384,
        jobs_per_tick: 32,
        max_pending: 4096,
    ),
)
