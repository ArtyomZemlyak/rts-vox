(
    cell_units: 8,
    search_nodes: 16000,
    // After recovery_ticks refused, the hull runs a cycle of escape
    // manoeuvres (ADR-273): astern, ahead, then each turning both ways by
    // recovery_turn_deg, escape_ticks each at escape_speed_pct of full speed.
    recovery_ticks: 36,
    escape_ticks: 42,
    escape_speed_pct: 30,
    recovery_turn_deg: 25,
    // The planner probes two units more contact than the hull: a plan never
    // leads into a grade the executor refuses between two search samples.
    plan_margin: 2,
    // Foliage and trunk of range-materials.ron. A tracked hull cuts what it
    // overlaps; the connected crown within the radius falls without a cut.
    fell: (materials: (4, 5), radius: 14, cells_per_tick: 4096, cost_per_column: 1, cost_cap: 20, speed_pct: 60),
)
