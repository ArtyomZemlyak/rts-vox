// Explicit IDs of RangeTerrain. Density unit = 10 kg/m3 (data/sim.ron).
(materials: [
    (id: 0, density: 0, strength: 0, harmful: false),
    // Loose matter crumbles into pieces when its support goes; cohesive
    // matter (concrete, steel, a trunk, rock) falls as one body (ADR-300).
    // Compacted soil: fracture costs four times the former loose-ground
    // preset. Weapon pressure, vegetation and hull materials are unchanged.
    (id: 1, density: 120, strength: 120, harmful: false, loose: true),
    // Concrete and steel do not burn, but heat enough and they run off as
    // debris (ADR-290): a bolt's spot is 120, a burning trunk feeds its
    // neighbours 600 over its two seconds.
    (id: 2, density: 240, strength: 140, bend_span: 5, harmful: false, melt: 900),
    (id: 3, density: 785, strength: 500, bend_span: 10, harmful: false, melt: 360),
    // Fuel: heat each neighbour receives over the burn of one voxel; kindling:
    // heat at which it lights (ADR-277). Four units a tick from one burning
    // neighbour light foliage in ten ticks; a trunk needs two burning sides.
    (id: 4, density: 6, strength: 5, harmful: false, fuel: 240, kindling: 30, loose: true), // foliage
    (id: 5, density: 70, strength: 10, bend_span: 3, harmful: false, fuel: 600, kindling: 120), // trunk
    (id: 6, density: 260, strength: 220, bend_span: 7, harmful: false), // rock
    (id: 7, density: 120, strength: 120, harmful: false, loose: true), // grass-covered soil
    (id: 8, density: 180, strength: 160, harmful: false, loose: true),
    // Normalised heat units: sustained flame and a hot nuclear pulse can vitrify sand.
    (id: 10, density: 160, strength: 8, harmful: false, loose: true, melt: 300), // dry sand
    (id: 12, density: 160, strength: 65, bend_span: 2, harmful: false, melt: 2400), // vitrified sand
    (id: 13, density: 785, strength: 5, harmful: false, melt: 100000), // liquid steel
    (id: 14, density: 240, strength: 5, harmful: false, melt: 100000), // liquid concrete
    (id: 16, density: 160, strength: 5, harmful: false, melt: 100000), // liquid glass
    (id: 11, density: 100, strength: 1, harmful: false), // water: separate conserved volume
    // Inventory-only liquid fuel; range-fire.ron controls its finite combustion.
    // Never a voxel, so its strength is never read; the loader asks one of
    // every material but air (ADR-429).
    (id: 9, density: 80, strength: 1, harmful: false),
])
