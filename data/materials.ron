// Ванильные материалы. Это такой же пак, как любой мод: движок грузит
// его тем же `load_pack`, и если бы у ванили был свой путь, обещание
// «мод работает как ванильный контент» проверялось бы только на словах.
//
// `id` — ЯВНЫЙ номер, а не позиция в списке (ADR-028). Переставить
// строки местами можно; поменять номер — значит сломать все сохранения.
//
// `density` — плотность: ресурс равен объёму на плотность. Богатая руда
// это отдельный материал с большей плотностью, а не модификатор (ADR-100).
// `strength` — сколько урона держит воксель.
// `harmful` — наносит ли урон тому, кто его касается.
(
    materials: [
        ( id:  0, density:    0, strength:    0, harmful: false ),  // воздух
        ( id:  1, density:  120, strength:   30, harmful: false ),  // почва
        ( id:  2, density:  260, strength:  140, harmful: false ),  // порода
        ( id:  3, density:  310, strength:  220, harmful: false ),  // глубинная порода
        ( id:  4, density:  250, strength:  115, harmful: false ),  // светлый пласт

        ( id: 16, density:  340, strength:  150, harmful: false ),  // железо бедное
        ( id: 17, density:  430, strength:  160, harmful: false ),  // железо
        ( id: 18, density:  560, strength:  175, harmful: false ),  // железо богатое

        ( id: 24, density:  360, strength:  130, harmful: false ),  // медь бедная
        ( id: 25, density:  455, strength:  140, harmful: false ),  // медь
        ( id: 26, density:  590, strength:  155, harmful: false ),  // медь богатая

        ( id: 40, density:  200, strength:    1, harmful: true  ),  // лава
    ],
)
