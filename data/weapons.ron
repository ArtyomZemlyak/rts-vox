// Оружие. Это такой же пак, как любой мод: мод добавляет своё оружие
// тем же файлом и тем же загрузчиком.
//
// `id` — ЯВНЫЙ номер, а не позиция в списке (ADR-028, ADR-169).
// Переставить строки местами можно; поменять номер — значит сломать
// все сохранения.
//
// `kind` задаёт, КАК приходит урон:
//   Bolt  — снаряд летит, тратит тики на дорогу, упирается в породу;
//   Laser — луч приходит в тот же тик по той же линии огня.
//
// `speed` — клеток в секунду, у луча не читается.
// `damage` — вокселей за попадание. У юнита их триста.
// `reload` — тиков между выстрелами; при 30 Гц тридцать это выстрел
//            в секунду.
// `blast_radius` — воронка от попадания, вокселей. Её правки идут
//            в ту же очередь, что копка (ADR-165).
(
    weapons: [
        ( id: 1, kind: Bolt,  speed: 200, damage: 30, reload: 30, blast_radius: 10, blast_damage: 10,
          mass_g: 6000, impact_energy_j: 950000 ),

        // Луч: вдвое чаще, вчетверо слабее, воронки нет. Против породы
        // бессилен — тем и отличается от болта.
        ( id: 2, kind: Laser, speed:  0, damage: 12, reload: 15, blast_radius: 0, blast_damage:  0,
          mass_g: 0, impact_energy_j: 240000 ),

        // Live material combat: a 6 kg projectile at 600 m/s, reach from attack-ranges.ron.
        // IDs 1/2 retain the reference workload; typed units use 3/4.
        ( id: 3, kind: Bolt, speed: 6000, damage: 30, reload: 60,
          blast_radius: 40, blast_damage: 10, mass_g: 6000,
          blast_energy_j: 6000000,
          impact_energy_j: 0, range: "kinetic" ),
        ( id: 4, kind: Laser, speed: 0, damage: 12, reload: 30,
          blast_radius: 0, blast_damage: 0, mass_g: 0,
          impact_energy_j: 240000, range: "machine_gun" ),
    ],
)
