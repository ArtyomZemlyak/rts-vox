// Fictional directed-energy projectile. CPU impulse is authoritative;
// the blue discharge is presentation and does not model real plasma confinement.
(
    motion: Direct,
    charge_ticks: 30,
    half_cells: 20,
    cell_units: 2,
    // Tank energy shot: stronger than the previous 1550-unit setting.
    energy: 2200,
    // No fracture budget: the burst annihilates what it takes.
    material_energy_j: 0,
    air_cost: 100,
    soil_resistance: 165,
    // Soil confinement per world unit below the impact; hull work is unchanged.
    soil_depth_cost: 300,
    concrete_resistance: 380,
    // Stock discharge leaves a dent, 2x stresses the face and 4x can tear it.
    steel_resistance: 6000,
    unit_ablation_resistance: 180,
    unit_role_resistance_milli: (1000, 1800, 650, 1100, 350),
    wave_work_per_tick: 98304,
    capture_cells_per_tick: 147456,
    edits_per_tick: 65536,
    // A bolt ablates finely: pieces within a two-cell box (ADR-284).
    fragment_box: 2,
    // A bolt pushes too, by the pressure its wave puts on the body: the
    // owner's call of 17.09.2026 (ADR-302). Its wave presses five times
    // the shell's over ten ticks, so a fifth of the shell's milli gives a
    // tank a metre from the burst the same shove.
    hull_impulse_milli: 20,
    fire_tick: 50,
    shell_speed: 1200,
    // A bolt heats a small spot hard (ADR-277).
    heat_units: 8,
    heat_per_cell: 120,
    gravity: 98,
    gas_cell_units: 5,
    // Visible cubes are larger than the transport grid; the physics is unchanged.
    gas_display_mm: 640,
    gas_source_radius: 27,
    gas_temperature_k: 3400,
    gas_fuel_milli: 0,
    gas_pressure_milli: 3200,
    reaction_milli: 0,
    cooling_milli: 1250,
    buoyancy_milli: 1000,
)
