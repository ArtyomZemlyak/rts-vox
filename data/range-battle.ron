// 20 Hz, world units = 0.1 m. Same kilometre map, one additional clear sector.
(
    tank_power_milli: 1000,
    // Reinforced emplacement capacitor: twice the ordinary energy round.
    turret_t2_power_milli: 2000,
    turret_t2_reload_ticks: Some(40),
    tank_reload_ticks: 60,
    tank_range: "tank_blast",
    artillery_range: "artillery",
    canister: (pellets: 6, spread_milli: 35, range: "canister", reload_ticks: 100, flight_time_milli: 2500, footprint_radius: 60),
    kinetic_range: "kinetic",
    energy_range: "energy",
    anni_range: "energy",
    pursuit_ticks: 40,
    standoff_milli: 750,
    // Pursuers attacking one target take firing positions a tank's length
    // and a margin apart (ADR-467): allies lined up with the target would
    // otherwise all drive for the same point before it.
    firing_spacing: 70,
    max_rounds: 64,
    max_waves: 16,
    // Per tick over all live waves (ADR-681): grid cells captured, frontier
    // heap pops, and contacts (a cell visited and each voxel of matter in
    // it). A wave takes its preset's own budget while these last.
    wave_capture_ceiling: 294912,
    wave_work_ceiling: 393216,
    wave_contact_ceiling: 393216,
    // Untouched chunks the tick's edit drain changes, built ahead in
    // parallel instead of one by one inside the drain.
    drain_chunk_ceiling: 64,
    // Flying-piece slots a wave's ground cells leave to the hulls it strikes.
    hull_piece_reserve: 1024,
    // Какой снаряд танк заряжает по цели (ADR-456): бронебойный
    // (`Kinetic`, kinetic-shell.ron) пробивает корпус и скалывает соседние воксели,
    // фугас (`Blast`) рвёт волной ноги шагохода и укрытие.
    tank_ammo: (tank: Kinetic, strider: Blast, ground: Blast),
    zone: (name: "Учебный бой", min: (3200,2000), max: (4100,2800),
        spawn: (3280,16,2400), target: (3900,15,2400)),
    units: [
        (kind: Tank, allied: true, at: (3360,16,2290)),
        (kind: Strider, allied: true, at: (3360,16,2490)),
        (kind: Tank, allied: false, at: (3860,16,2290)),
        (kind: Strider, allied: false, at: (3860,16,2490)),
    ],
)
