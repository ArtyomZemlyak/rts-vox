// 30 Hz, world units = 0.1 m. Same kilometre map, one additional clear sector.
(
    tank_power_milli: 1000,
    tank_reload_ticks: 90,
    tank_range: 700,
    kinetic_range: 900,
    energy_range: 1200,
    anni_range: 1000,
    pursuit_ticks: 60,
    standoff_milli: 750,
    // Pursuers attacking one target take firing positions a tank's length
    // and a margin apart (ADR-467): allies lined up with the target would
    // otherwise all drive for the same point before it.
    firing_spacing: 70,
    max_rounds: 64,
    max_waves: 4,
    // Какой снаряд танк заряжает по цели (ADR-456): бронебойный
    // (`Kinetic`, kinetic-shell.ron) пробивает корпус и скалывает соседние воксели,
    // фугас (`Blast`) рвёт волной ноги шагохода и укрытие.
    tank_ammo: (tank: Kinetic, strider: Blast, ground: Blast),
    zone: (name: "Учебный бой", min: (3200,2000), max: (4100,2800),
        spawn: (3280,16,2400), target: (3900,15,2400)),
    units: [
        (kind: Tank, allied: true, at: (3360,16,2290)),
        (kind: Strider, allied: true, at: (3360,16,2490)),
        (kind: Tank, allied: false, at: (3860,16,2290)),
        (kind: Strider, allied: false, at: (3860,16,2490)),
    ],
)
