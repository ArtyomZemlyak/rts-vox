// Operating limits of installed machinery, independent of exterior armour.
(
    core_volume_pct: 60,
    core_section_pct: 30,
    engine_volume_pct: 20,
    gear_section_pct: 30,
    required_gears_pct: 75,
    // A walker's leg that lost more than this share of its thigh and shin
    // cells buckles: it folds under the hip and carries nothing (ADR-281).
    leg_buckle_pct: 50,
    // A buckled leg folds on its own foot: the foot keeps this share of
    // its rest reach from the hip, so the knee bends out (ADR-288).
    leg_fold_pct: 35,
    // A walker with fewer than two legs carrying — dead, or every leg
    // buckled or lost — sits at this share of its clearance (ADR-304).
    collapse_clearance_pct: 25,
)
