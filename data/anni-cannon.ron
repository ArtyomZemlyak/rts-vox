// Fictional annihilation bolt (ADR-285): the energy cannon's wave, but
// matter goes whatever its strength and leaves nothing behind. Every
// resistance is the same small number, so soil, concrete, steel and armour
// vanish alike; no material energy means no debris (the annihilation sink),
// and no heat means nothing burns. The bending of the picture around the
// bolt is presentation.
(
    motion: Direct,
    charge_ticks: 45,
    half_cells: 20,
    cell_units: 2,
    energy: 2700,
    air_cost: 100,
    soil_resistance: 120,
    concrete_resistance: 120,
    steel_resistance: 120,
    unit_ablation_resistance: 120,
    unit_role_resistance_milli: (1000, 1000, 1000, 1000, 1000),
    wave_work_per_tick: 4096,
    edits_per_tick: 8192,
    // Pieces within a two-cell box, though the bolt leaves none (ADR-284).
    fragment_box: 2,
    fire_tick: 75,
    shell_speed: 1200,
    heat_units: 0,
    heat_per_cell: 0,
    gravity: 98,
    gas_cell_units: 5,
    gas_source_radius: 18,
    gas_temperature_k: 900,
    gas_fuel_milli: 0,
    gas_pressure_milli: 900,
    reaction_milli: 0,
    cooling_milli: 2500,
    buoyancy_milli: 400,
)
