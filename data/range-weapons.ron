// World units: 100 mm. Simulation: 30 ticks per second.
(
    flame: (burst_ticks: 72, interval_ticks: 2, range: 300,
        standoff_milli: 750,
        spread_milli: 70, work: 85, heat: 55, heat_radius: 2,
        fracture_j: 80000, reload_ticks: 20),
    // Six paired salvos per burst instead of ten: each shot is heavier,
    // while work and fracture energy over the full burst stay comparable.
    machine_gun: (burst_ticks: 30, interval_ticks: 5, range: 2400,
        standoff_milli: 750,
        spread_milli: 3, work: 500, heat: 0, heat_radius: 0,
        fracture_j: 100000, reload_ticks: 12),
    // A continuous hitscan beam deposits modest heat each tick at the first
    // solid cell. The thermal field melts a hole over time, one layer at a time.
    laser: (burst_ticks: 150, interval_ticks: 1, range: 2000,
        standoff_milli: 800,
        spread_milli: 0, work: 40, heat: 40, heat_radius: 0,
        fracture_j: 1, reload_ticks: 30),
    // Large, short-lived cubic puffs from moving tank tracks. Visual only;
    // the separate cap leaves room in the shared pool for impacts and fire.
    dust: (interval_ticks: 3, min_speed: 5, full_speed: 40,
        min_turn_rate: 18, full_turn_rate: 90, max_particles: 128,
        edge_milli: 4400, life_milli: 1000, rise_milli: 2600,
        trail_milli: 6500, rear_milli: 80, lateral_milli: 460,
        floor_probe: 6),
    smoke_engine_milli: 750, smoke_core_milli: 900, smoke_loss_milli: 180,
)
